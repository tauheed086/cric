{
  "name": "local-cric-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run -w @cric/types build && npm run -w @cric/api build && npm run -w @cric/web build",
    "dev": "npm run -w @cric/web dev",
    "dev:api": "npm run -w @cric/api start:dev",
    "dev:web": "npm run -w @cric/web dev",
    "test": "npm run -ws test",
    "lint": "npm run -ws lint",
    "format": "npm run -ws format"
  }
}
